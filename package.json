{
  "name": "gemini2codex",
  "version": "2.3.0",
  "description": "Local MCP server connecting Codex to Gemini agents and writing tools",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gemini2codex": "scripts/launch.mjs"
  },
  "files": [
    "dist",
    "src",
    "native",
    "scripts/build-native.mjs",
    "scripts/install-codex.mjs",
    "docs/AGENTS.gemini-writer.md",
    "tsconfig.json",
    ".env.example",
    "*.cmd",
    "scripts/launch.mjs"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-native.mjs",
    "prepare": "npm run build",
    "start": "node scripts/launch.mjs",
    "healthcheck": "node scripts/launch.mjs --healthcheck",
    "configure:codex": "node scripts/install-codex.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "dotenv": "^17.2.3",
    "playwright": "1.64.0",
    "undici": "^7.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiassia/gemini2codex.git"
  },
  "bugs": {
    "url": "https://github.com/jiassia/gemini2codex/issues"
  },
  "homepage": "https://github.com/jiassia/gemini2codex#readme"
}
