# Parent process environment variables take precedence over this file.
WRITER_PROVIDER=agy
AGY_COMMAND=agy
AGY_MODEL=gemini-3.8-flash-medium
AGY_AGENT_MODEL=gemini-3.8-flash-high
AGENT_MIN_INTERVAL_MS=5000
# 0 waits for agy to finish, with no MCP execution deadline.
AGENT_TIMEOUT_MS=0
AGENT_PROVIDER_TIMEOUT_MS=0
WRITER_TIMEOUT_MS=0
MAX_INPUT_CHARS=24000
MAX_OUTPUT_CHARS=100000
MAX_ATTEMPTS=1
LOG_LEVEL=info

# Check GitHub stable release tags before starting MCP. Set 0 to disable.
GEMINI2CODEX_AUTO_UPDATE=1

# Optional durable task directory. The default is under the current user's AppData.
# WRITER_STATE_DIR=C:/work/gemini-writer-state

# Explicit API provider only; never an automatic fallback.
# WRITER_PROVIDER=gemini-api
# GEMINI_API_KEY=your-own-key
# GEMINI_API_MODEL=your-verified-api-model-id

# Optional proxy: use your actual Clash HTTP/mixed listener.
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# ALL_PROXY=http://127.0.0.1:7897
# NO_PROXY=127.0.0.1,localhost
